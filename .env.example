# AI Career Agent — Local Development Environment
# Copy this file to `.env` and fill values. `.env` is gitignored.
# Canonical example: `config/.env.example` (kept in sync).

# --- App / runtime ---
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production
ENCRYPTION_KEY=  # Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Database ---
POSTGRES_USER=ai_career_agent
POSTGRES_PASSWORD=localdev_password_change_in_production
POSTGRES_DB=ai_career_agent
DATABASE_URL=postgresql+asyncpg://ai_career_agent:${POSTGRES_PASSWORD}@localhost:5432/ai_career_agent

# --- Redis (declared, NOT required at runtime; scheduler is in-process and OFF by default) ---
REDIS_URL=redis://localhost:6379/0

# --- Scheduler (OFF by default — only explicit opt-in starts runs) ---
DISCOVERY_ENABLED=false

# --- Job sources (optional Adzuna adapter — env-only credentials, never fabricated) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Matching (deterministic scorer) ---
MATCH_THRESHOLD=70.0

# --- Automation / outreach (recorded only; real submission is a future phase) ---
AUTOMATION_ENABLED=true
OUTREACH_ENABLED=true
OUTREACH_APPROVAL_REQUIRED=true

# --- Object storage (local provider by default; cloud provider optional) ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/uploads