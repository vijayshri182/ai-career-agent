# AI Career Agent — Local Development Environment
# Copy this file to .env and fill values. .env is gitignored.

# PostgreSQL
POSTGRES_USER=ai_career_agent
POSTGRES_PASSWORD=localdev_password_change_in_production
POSTGRES_DB=ai_career_agent
DATABASE_URL=postgresql+asyncpg://ai_career_agent:${POSTGRES_PASSWORD}@localhost:5432/ai_career_agent

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_change_in_production
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=${MINIO_ROOT_USER}
OBJECT_STORAGE_SECRET_KEY=${MINIO_ROOT_PASSWORD}

# LLM provider
LLM_API_KEY=your-llm-api-key

# OAuth/OIDC
AUTH_CLIENT_SECRET=your-auth-client-secret

# Email
SMTP_HOST=smtp.example.com
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password

# Auth / encryption
SECRET_KEY=replace-with-a-long-random-secret
ENCRYPTION_KEY=  # Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/uploads

# Optional monitoring
SENTRY_DSN=
