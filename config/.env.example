# AI Career Agent — Environment Example
# Copy to `.env` and fill with real values. `.env` is gitignored.
# Mirrors the full settings surface in `src/backend/core/config.py`.

# --- App / runtime ---
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production
ENCRYPTION_KEY=  # Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Database ---
DATABASE_URL=postgresql+asyncpg://ai_career_agent:localdev_password_change_in_production@localhost:5432/ai_career_agent

# --- Redis (declared, NOT required at runtime; scheduler is in-process and OFF by default) ---
REDIS_URL=redis://localhost:6379/0

# --- Scheduler (OFF by default — only explicit opt-in starts runs) ---
DISCOVERY_ENABLED=false
DISCOVERY_INTERVAL_SECONDS=21600
CRAWL_USER_AGENT=
CRAWL_TIMEOUT_SECONDS=20.0
CRAWL_BACKOFF_SECONDS=2.0
CRAWL_MAX_RETRIES=2

# --- Job sources (optional Adzuna adapter — env-only credentials, never fabricated) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Matching (deterministic scorer) ---
MATCH_RULES_VERSION=3.0.0
MATCH_WEIGHTS=
MATCH_THRESHOLD=70.0

# --- Automation / outreach (recorded only; real submission is a future phase) ---
AUTONOMY_LEVEL=2
AUTOMATION_ENABLED=true
AUTOMATION_MAX_ATTEMPTS=3
OUTREACH_ENABLED=true
OUTREACH_APPROVAL_REQUIRED=true
OUTREACH_DAILY_LIMIT=20
OUTREACH_MAX_ATTEMPTS=3
ANALYTICS_ENABLED=true
NOTIFICATION_ENABLED=true

# --- Object storage (local provider by default; cloud provider optional) ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/uploads
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=ai-career-agent-documents
STORAGE_REGION=us-east-1
STORAGE_ENCRYPT_FILES=true