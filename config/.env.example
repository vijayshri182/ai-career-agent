# AI Career Agent — Environment Example
# Copy to .env and fill with real values. .env is gitignored.

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_career_agent

# Redis
REDIS_URL=redis://localhost:6379/0

# Object storage
OBJECT_STORAGE_ENDPOINT=https://s3.amazonaws.com
OBJECT_STORAGE_ACCESS_KEY=your-access-key
OBJECT_STORAGE_SECRET_KEY=your-secret-key

# LLM provider
LLM_API_KEY=your-llm-api-key

# OAuth/OIDC
AUTH_CLIENT_SECRET=your-auth-client-secret

# Email
SMTP_HOST=smtp.example.com
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password

# Optional: Sentry / monitoring
SENTRY_DSN=
